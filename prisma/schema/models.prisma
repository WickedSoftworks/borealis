// Application data model.
//
// NOTE: every enum-ish column is a String, not a Prisma enum. SQLite has no
// enum support, and this schema must generate identically for both sqlite and
// postgresql. Allowed values live in lib/constants.ts — keep them in sync.

model Folder {
  id        String    @id @default(cuid())
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  parentId String?
  parent   Folder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children Folder[] @relation("FolderTree")

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  files      File[]
  shareItems ShareItem[]

  @@index([ownerId])
  @@index([parentId])
}

model File {
  id           String   @id @default(cuid())
  /// Server-generated key the StorageProvider addresses. Never user input.
  storageKey   String   @unique
  originalName String
  mimeType     String
  size         BigInt
  /// sha256 of the stored bytes, computed by the CHECKSUM job after upload.
  /// E2E uploads are hashed too: the digest covers the ciphertext the server
  /// actually holds, NOT the user's plaintext — never offer it to a recipient
  /// as something to check a decrypted file against. Null means "not yet
  /// computed", which on a healthy instance is a transient state.
  checksum     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  /// Soft delete — trash. The expiry sweep enqueues a PURGE_FILE job once
  /// TRASH_RETENTION_DAYS have passed, and that job removes bytes and row
  /// together. Null means live; every list, search, and share query filters
  /// on it. An admin deleting another account's file skips the trash entirely.
  deletedAt DateTime?

  /// True when the bytes were encrypted client-side. The server never holds the key.
  isEncrypted Boolean @default(false)
  /// JSON: { salt, iv, chunkSize, algorithm }. Never contains key material.
  encryptionMeta String?

  /// Storage key of a small WebP preview, written by the THUMBNAIL job. Null
  /// until the job runs, and forever for E2E files and types it cannot draw.
  thumbnailKey String?

  /// Malware scan verdict from the SCAN_FILE job, when ClamAV is configured.
  /// "CLEAN" | "INFECTED" | "SKIPPED" | "FAILED". Null means not scanned — which
  /// is every file on an instance without CLAMAV_HOST. An INFECTED file is
  /// refused by every public route; its owner can still reach it.
  scanStatus String?
  /// The scanner's own words: the signature name, or why the scan was skipped.
  scanDetail String?

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  folderId String?
  folder   Folder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  text       FileText?
  shareItems ShareItem[]
  accesses   ShareAccess[]

  @@index([ownerId])
  @@index([folderId])
  @@index([deletedAt])
  /// Non-unique: identical bytes are legal today. Groundwork for dedupe.
  @@index([checksum])
}

/// A share bundles files/folders behind one public token.
/// type: "SEND" (owner shares out) | "REVERSE" (public uploads in)
model Share {
  id          String  @id @default(cuid())
  token       String  @unique
  type        String  @default("SEND")
  name        String?
  description String?

  /// scrypt hash, `scrypt$N$r$p$salt$hash`. Null = no password gate.
  /// An input to the unlock cookie's MAC, so rewriting it revokes every unlock.
  passwordHash String?

  /// Null means "forever" — the plan's expiry presets all collapse to this.
  expiresAt DateTime?
  revokedAt DateTime?

  /// Null = unlimited. Enforced by lib/shares/guard.ts before any bytes stream.
  maxDownloads  Int?
  downloadCount Int  @default(0)

  /// Null = unlimited. Protects a self-hosted box from a leaked link.
  egressLimitBytes BigInt?
  egressUsedBytes  BigInt  @default(0)

  /// Stream a preview but refuse download.
  viewOnly Boolean @default(false)
  /// Payload is client-side encrypted; server cannot preview, scan, or index it.
  isE2E    Boolean @default(false)

  notifyOnDownload Boolean @default(false)
  notifyEmail      String?

  /// Comma-separated IPs and CIDR ranges allowed to open this link. Null means
  /// anyone. Checked against lib/request.ts's clientIp(), so it is only as
  /// strong as the TRUST_PROXY configuration behind it.
  allowedIps String?

  // REVERSE-share settings (ignored when type = "SEND")
  maxUploadBytes  BigInt?
  maxUploadFiles  Int?
  requireUploader Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  items    ShareItem[]
  accesses ShareAccess[]

  @@index([ownerId])
  @@index([expiresAt])
}

model ShareItem {
  id String @id @default(cuid())

  shareId String
  share   Share  @relation(fields: [shareId], references: [id], onDelete: Cascade)

  fileId String?
  file   File?   @relation(fields: [fileId], references: [id], onDelete: Cascade)

  folderId String?
  folder   Folder? @relation(fields: [folderId], references: [id], onDelete: Cascade)

  @@unique([shareId, fileId])
  @@unique([shareId, folderId])
  @@index([shareId])
}

/// Per-share audit trail. Also the source of truth for egress accounting.
/// action: "VIEW" | "DOWNLOAD" | "UNLOCK_FAIL" | "UPLOAD" | "DENIED"
model ShareAccess {
  id          String   @id @default(cuid())
  action      String
  ipAddress   String?
  userAgent   String?
  bytesServed BigInt   @default(0)
  createdAt   DateTime @default(now())

  shareId String
  share   Share  @relation(fields: [shareId], references: [id], onDelete: Cascade)

  fileId String?
  file   File?   @relation(fields: [fileId], references: [id], onDelete: SetNull)

  @@index([shareId, createdAt])
}

/// Extracted/OCR'd text backing full-text search.
/// status: "PENDING" | "DONE" | "FAILED" | "SKIPPED"
model FileText {
  fileId      String   @id
  file        File     @relation(fields: [fileId], references: [id], onDelete: Cascade)
  content     String   @default("")
  status      String   @default("PENDING")
  error       String?
  extractedAt DateTime?
  updatedAt   DateTime @updatedAt

  @@index([status])
}

/// DB-backed job queue, polled by the worker started in instrumentation.ts.
/// Deliberately not Redis/BullMQ: self-hosting must stay a single container.
/// type: "EXTRACT_TEXT" | "CHECKSUM" | "EXPIRE_SWEEP" | "NOTIFY_DOWNLOAD" |
///       "PURGE_FILE" | "THUMBNAIL" | "SCAN_FILE" | "RECONCILE_STORAGE" |
///       "OCR_FILE"
/// status: "PENDING" | "RUNNING" | "DONE" | "FAILED"
model Job {
  id       String   @id @default(cuid())
  type     String
  payload  String   @default("{}")
  status   String   @default("PENDING")
  attempts Int      @default(0)
  lastError String?
  runAt    DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, runAt])
}

/// Runtime admin configuration, editable from the admin panel without a
/// restart. Read through lib/settings.ts, which falls back to the environment
/// for any key that has no row, so an unconfigured instance behaves exactly as
/// its .env says. `value` is JSON.
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// What an operator did, as opposed to what a recipient did (`ShareAccess`).
///
/// Written for actions taken on someone else's account or on the instance:
/// bans, role changes, deleting another user's file, settings changes, job
/// retries. The actor is kept as a copied email as well as an id, so the record
/// still reads correctly after the acting account is deleted.
/// action: see AUDIT_ACTIONS in lib/constants.ts
model AuditEvent {
  id         String   @id @default(cuid())
  action     String
  actorId    String?
  actorEmail String?
  /// "user" | "file" | "setting" | "job" | "instance"
  targetType String
  targetId   String?
  /// Human-readable subject at the time — an email, a filename, a setting key.
  targetLabel String?
  /// JSON with whatever else makes the row self-explanatory.
  detail     String?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([actorId])
}

/// A named, expiring claim. One row per singleton duty — the hourly sweep, for
/// one — so that N replicas each running a worker still perform it once.
/// Acquired and renewed with a conditional update in lib/lease.ts.
model Lease {
  name      String   @id
  holder    String
  expiresAt DateTime
}
