# Signs every session cookie. The app refuses to start without it.
#   openssl rand -base64 32
BETTER_AUTH_SECRET=

# The origin of where the server actually lives
#   e.g. http://localhost:3000 or https://myapp.com
# This requires installation via Docker, see without docker below

# BOREALIS_URL=http://localhost:3000

# Host port to expose
# This requires installation via Docker, see without docker below
# BOREALIS_PORT=3000

#
#   INSTALLATION WITHOUT DOCKER
#

# Uncomment BOTH of these for `bun run setup && bun run dev`. Leave them
# commented for Docker: BETTER_AUTH_URL comes from BOREALIS_URL, and a
# host-relative DATABASE_URL would bypass the borealis-data volume.

# BETTER_AUTH_URL=http://localhost:3000
# DATABASE_URL=file:./data/borealis.db

#
#   DATABASE CONFIGURATION
#

# sqlite (default) or postgresql. The prisma client is generated at BUILD time for one provider,
# so changing this means that you need to run `bun run db:setup` again, or re-compose in Docker
# DATABASE_PROVIDER=sqlite

# Docker default: file:/app/data/borealis.db
# Postgres:       postgresql://borealis:borealis@postgres:5432/borealis
# DATABASE_URL=

# Only read under `--profile postgres`
# POSTGRES_USER=borealis
# POSTGRES_PASSWORD=borealis
# POSTGRES_DB=borealis

#
#   STORAGE CONFIGURATION
#

# Local storage (default) or S3. You don't need to rebuild to change this
# STORAGE_DRIVER=local

# Where the local files land. Docker resolves this to /app/uploads
# STORAGE_PATH=./uploads

# Only read when STORAGE_DRIVER=s3. S3_BUCKET is required in that case; the
# app throws at startup without it.
# S3_BUCKET=
# S3_ENDPOINT=
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# true for MinIO and most S3-compatible services, false for real AWS S3.
# S3_FORCE_PATH_STYLE=true

#
#   TRASH CONFIGURATION
#

# How long a deleted file keeps its bytes before the PURGE_FILE job removes
# them for good. Days; fractions allowed. Defaults to 7. An unusable value
# (zero, negative, not a number) falls back to the default rather than
# refusing to boot.
#
# Deleting your own file trashes it; deleting someone else's — which needs
# admin or root — removes it immediately and is not recoverable.
# TRASH_RETENTION_DAYS=7

#
#   INSTANCE, LIMITS, AND RETENTION
#
# Everything in this section, and SMTP below, can also be changed at runtime
# from Admin → Settings. A value saved there wins over the one here; clearing
# it there falls back to this file again.

# The name shown in the header, on share pages, and in emails.
# INSTANCE_NAME=Borealis

# Sizes accept 50GB, 512 MB, 1.5TB, or a byte count (binary units: 1 GB =
# 1024^3). Empty, 0, none, or unlimited mean no ceiling — the default for all
# three. Trash counts against an account until it is purged.
# Per account, for accounts without their own (set per user in Admin → Users):
# DEFAULT_QUOTA=
# Everything stored on the instance, by everyone:
# STORAGE_CEILING=
# The largest single upload:
# MAX_UPLOAD_SIZE=

# Days of share access log (views, downloads, failed unlocks) to keep.
# AUDIT_RETENTION_DAYS=30

# Hours an unfinished upload may sit before its bytes are removed. Long
# enough to resume after a dropped connection or a laptop closed overnight.
# UPLOAD_EXPIRY_HOURS=24

#
#   EMAIL CONFIGURATION
#

#  Needs SMTP_HOST and SMTP_FROM together. Without both, password reset and
# verification links are written to the log instead of sent.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# Defaults to true when SMTP_PORT is 465 (implicit TLS), false otherwise
# (587 and 25 upgrade via STARTTLS).
# SMTP_SECURE=

#
#   SIGN-IN PROVIDER CONFIGURATION
#

# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=

# Generic OIDC. All three are required together; the discovery URL is derived
# from the issuer.
# OIDC_ISSUER=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_DISPLAY_NAME=Single Sign-On

#
#   PROXY CONFIGURATION
#

# Which X-Forwarded-For entries to believe. It decides the address recorded in
# the access log, rate limits, lockouts, and IP allow lists — so get it right.
#   false        trust nothing; no client address is recorded (default)
#   1            one reverse proxy in front (Caddy, nginx, Traefik): take the
#                address that proxy saw. 2 for two proxies in a chain, etc.
#   10.0.0.0/8   trust exactly these proxy addresses (comma-separated CIDRs);
#                the first address from the right outside them is the client
#   true         trust the whole header — forgeable by anyone who can reach
#                the app directly. Only for a proxy that overwrites the header.
# Exposed to the internet with no proxy, leave it false.
# TRUST_PROXY=false

#
#   SECURITY
#

# Addresses refused everywhere — sign-in, share pages, uploads — as
# comma-separated IPs or CIDRs. Needs TRUST_PROXY to see real addresses.
# Also editable in Admin → Settings.
# DENIED_IPS=

# Login, unlock, invite, upload, and download rate limits are on by default.
# `off` disables them (tests, or a proxy that already limits). The per-link
# lockout after repeated wrong share passwords stays on regardless.
# RATE_LIMIT=on

#
#   SEARCH AND OCR
#

# Images and scanned PDFs are read by OCR (Tesseract, running in-process, with
# the English model bundled — no network) so their text is searchable. It is
# the slowest job the worker runs; `off` skips it on a box that cannot spare
# the CPU, and such files are then stored and served but not indexed.
# OCR=on
# Tesseract language codes joined with +. Anything but eng needs its
# <code>.traineddata.gz in OCR_LANG_PATH (from @tesseract.js-data/<code>).
# OCR_LANGUAGES=eng
# OCR_LANG_PATH=
# Pages of a scanned PDF to read; the rest are left unindexed.
# OCR_MAX_PAGES=30

#
#   VIRUS SCANNING (optional)
#

# A clamd to stream every readable upload through. A file it flags is withheld
# from every share and collection link. End-to-end encrypted files cannot be
# scanned. docker-compose.yml has a `clamav` profile that runs one.
# CLAMAV_HOST=
# CLAMAV_PORT=3310
# Larger files are skipped rather than failed; match clamd's StreamMaxLength.
# CLAMAV_MAX_BYTES=26214400

#
#   OPERATIONS
#

# text (default) or json, one event per line, for a log shipper.
# LOG_FORMAT=text
# debug, info, warn, or error.
# LOG_LEVEL=info

# Prometheus metrics at /api/metrics, for a request with
# `Authorization: Bearer <token>`. Unset, the endpoint is a 404.
# METRICS_TOKEN=

# Every server error is POSTed here as JSON (a Sentry relay, a chat webhook, a
# script). Share tokens in the path are masked first.
# ERROR_WEBHOOK_URL=

# The daily storage check reports objects no file points at. `true` also
# deletes those older than 7 days; otherwise delete from Admin → Storage.
# RECONCILE_DELETE=false

# Where `bun run root backup` writes when no directory is given.
# BACKUP_DIR=./backups