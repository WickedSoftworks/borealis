{
  "name": "borealis",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "format": "biome format --write",
    "typecheck": "tsc --noEmit",
    "db:setup": "bun run scripts/set-db-provider.mts && prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:studio": "prisma studio",
    "root": "tsx --env-file=.env scripts/root.mts",
    "setup": "bun run db:setup && bun run db:migrate && bun run root seed",
    "test": "bun test",
    "test:integration": "bun test --timeout 120000 ./test/integration/shares.integration.ts ./test/integration/worker.integration.ts ./test/integration/security.integration.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/lib-storage": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@better-auth/passkey": "^1.7.10",
    "@dnd-kit/core": "^6.3.1",
    "@hookform/resolvers": "^6.0.0",
    "@prisma/adapter-better-sqlite3": "7.10.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tus/file-store": "^2.1.1",
    "@tus/s3-store": "^2.0.8",
    "@tus/server": "^2.4.6",
    "better-auth": "^1.7.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.59.0",
    "next": "16.4.2",
    "nodemailer": "^10.1.6",
    "pg": "^8.23.1",
    "prisma": "7.10.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.90.0",
    "shadcn": "^4.22.0",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "tesseract.js": "^7.0.0",
    "tus-js-client": "^4.3.1",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^1.9.0",
    "uqr": "^0.1.3",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bun": "^1.4.3",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/uuid": "^11.0.0",
    "dotenv": "^18.0.8",
    "puppeteer-core": "^25.14.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "@prisma/engines",
    "better-sqlite3",
    "esbuild",
    "prisma",
    "sharp",
    "unrs-resolver"
  ]
}
