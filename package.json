{
  "name": "borealis",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "format": "biome format --write",
    "typecheck": "tsc --noEmit",
    "db:setup": "bun run scripts/set-db-provider.mts && prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:studio": "prisma studio",
    "root": "tsx --env-file=.env scripts/root.mts",
    "setup": "bun run db:setup && bun run db:migrate && bun run root seed",
    "test": "bun test",
    "test:integration": "bun test --timeout 120000 ./test/integration/shares.integration.ts ./test/integration/worker.integration.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1107.0",
    "@aws-sdk/lib-storage": "^3.1107.0",
    "@aws-sdk/s3-request-presigner": "^3.1107.0",
    "@better-auth/passkey": "^1.6.19",
    "@dnd-kit/core": "^6.3.1",
    "@hookform/resolvers": "^5.4.0",
    "@prisma/adapter-better-sqlite3": "7.9.1",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tus/file-store": "^2.1.1",
    "@tus/s3-store": "^2.0.5",
    "@tus/server": "^2.4.3",
    "better-auth": "^1.6.19",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.20.0",
    "mammoth": "^1.12.1",
    "next": "16.2.9",
    "nodemailer": "^9.0.5",
    "pg": "^8.21.0",
    "prisma": "7.9.1",
    "radix-ui": "^1.6.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.79.0",
    "shadcn": "^4.11.0",
    "sharp": "^0.35.4",
    "tailwind-merge": "^3.6.0",
    "tesseract.js": "^7.0.0",
    "tus-js-client": "^4.3.1",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^1.8.0",
    "uqr": "^0.1.3",
    "uuid": "^14.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "@tailwindcss/postcss": "^4",
    "@types/bun": "^1.3.14",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^11.0.0",
    "dotenv": "^17.4.2",
    "puppeteer-core": "^25.6.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "@prisma/engines",
    "better-sqlite3",
    "esbuild",
    "prisma",
    "sharp",
    "unrs-resolver"
  ]
}
